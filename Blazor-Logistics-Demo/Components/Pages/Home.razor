@page "/"
@rendermode InteractiveServer
@inject IShipmentService ShipmentService

<PageTitle>Dashboard</PageTitle>

<h1>Logistics Dashboard</h1>

@if (_shipments is null)
{
    <p>Loading...</p>
}
else
{
    <div class="kpi-grid">
        <KpiCard Title="Total Shipments" Value="@_shipments.Count.ToString()" />
        <KpiCard Title="Pending" Value="@_shipments.Count(x => x.Status == ShipmentStatus.Pending).ToString()" />
        <KpiCard Title="In Transit" Value="@_shipments.Count(x => x.Status == ShipmentStatus.InTransit).ToString()" />
        <KpiCard Title="Delivered" Value="@_shipments.Count(x => x.Status == ShipmentStatus.Delivered).ToString()" />
    </div>

    <div class="panel">
        <h3>Recent Shipments</h3>

        <table class="table">
            <thead>
                <tr>
                    <th>Tracking #</th>
                    <th>Customer</th>
                    <th>Route</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shipment in _shipments.Take(5))
                {
                    <tr>
                        <td>@shipment.TrackingNumber</td>
                        <td>@shipment.CustomerName</td>
                        <td>@shipment.Origin → @shipment.Destination</td>
                        <td>@shipment.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Shipment>? _shipments;

    protected override async Task OnInitializedAsync()
    {
        _shipments = await ShipmentService.GetAllAsync();
    }
}