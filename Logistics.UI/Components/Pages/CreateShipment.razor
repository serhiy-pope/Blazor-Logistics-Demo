@page "/shipments/create"
@inject IShipmentService ShipmentService
@inject NavigationManager NavigationManager

<PageTitle>Create Shipment</PageTitle>

<div class="page-header">
    <h1>Create Shipment</h1>
    <p class="page-subtitle">Register a new shipment and add it to the tracking board.</p>
</div>

<div class="panel panel--form">
    <div class="panel-body">
        <EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="field">
                    <label>Tracking Number</label>
                    <InputText class="form-control" placeholder="e.g. SHP-1042" @bind-Value="_model.TrackingNumber" />
                    <ValidationMessage For="() => _model.TrackingNumber" />
                </div>

                <div class="field">
                    <label>Customer Name</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerName" />
                    <ValidationMessage For="() => _model.CustomerName" />
                </div>

                <div class="field">
                    <label>Origin</label>
                    <InputText class="form-control" @bind-Value="_model.Origin" />
                    <ValidationMessage For="() => _model.Origin" />
                </div>

                <div class="field">
                    <label>Destination</label>
                    <InputText class="form-control" @bind-Value="_model.Destination" />
                    <ValidationMessage For="() => _model.Destination" />
                </div>

                <div class="field">
                    <label>Weight (kg)</label>
                    <InputNumber class="form-control" @bind-Value="_model.WeightKg" />
                    <ValidationMessage For="() => _model.WeightKg" />
                </div>

                <div class="field">
                    <label>Carrier</label>
                    <InputText class="form-control" @bind-Value="_model.Carrier" />
                    <ValidationMessage For="() => _model.Carrier" />
                </div>

                <div class="field">
                    <label>Status</label>
                    <InputSelect class="form-control" @bind-Value="_model.Status">
                        @foreach (var status in Enum.GetValues<ShipmentStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">Save Shipment</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly CreateShipmentRequest _model = new();

    private async Task HandleValidSubmit()
    {
        await ShipmentService.CreateAsync(_model);
        NavigationManager.NavigateTo("/shipments");
    }

    private void Cancel() => NavigationManager.NavigateTo("/shipments");
}
