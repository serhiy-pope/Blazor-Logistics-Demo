@page "/shipments"
@rendermode InteractiveServer
@inject IShipmentService ShipmentService
@inject NavigationManager NavigationManager

<PageTitle>Shipments</PageTitle>

<div class="page-header">
    <h1>Shipments</h1>
    <p class="page-subtitle">Search, filter and inspect individual shipments.</p>
</div>

<div class="toolbar">
    <div class="search">
        <Icon Name="search" Size="16" />
        <input class="form-control"
               placeholder="Search by tracking number or customer"
               @bind="_searchTerm"
               @bind:event="oninput" />
    </div>

    <select class="form-control" @bind="_selectedStatus">
        <option value="">All statuses</option>
        @foreach (var status in Enum.GetNames<ShipmentStatus>())
        {
            <option value="@status">@status</option>
        }
    </select>

    <button class="btn btn-primary" @onclick="GoToCreate">
        <Icon Name="plus" Size="16" /> Create Shipment
    </button>
</div>

@if (_shipments is null)
{
    <div class="loading">Loading shipments...</div>
}
else
{
    <div class="panel">
        @if (!FilteredShipments.Any())
        {
            <div class="empty-state">
                <Icon Name="inbox" Size="30" />
                <p>No shipments match your filters.</p>
            </div>
        }
        else
        {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Tracking #</th>
                        <th>Customer</th>
                        <th>Origin</th>
                        <th>Destination</th>
                        <th>Carrier</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shipment in FilteredShipments)
                    {
                        <tr>
                            <td class="cell-mono">@shipment.TrackingNumber</td>
                            <td>@shipment.CustomerName</td>
                            <td>@shipment.Origin</td>
                            <td>@shipment.Destination</td>
                            <td class="text-muted">@shipment.Carrier</td>
                            <td><StatusBadge Status="shipment.Status" /></td>
                            <td class="cell-actions">
                                <button class="btn btn-link" @onclick="() => OpenDetails(shipment.Id)">
                                    Details
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    </div>
}

@code {
    private IReadOnlyList<Shipment>? _shipments;
    private string _searchTerm = string.Empty;
    private string _selectedStatus = string.Empty;

    private IEnumerable<Shipment> FilteredShipments =>
        (_shipments ?? [])
        .Where(x =>
            string.IsNullOrWhiteSpace(_searchTerm) ||
            x.TrackingNumber.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
            x.CustomerName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(x =>
            string.IsNullOrWhiteSpace(_selectedStatus) ||
            x.Status.ToString().Equals(_selectedStatus, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _shipments = await ShipmentService.GetAllAsync();
    }

    private void OpenDetails(Guid id) => NavigationManager.NavigateTo($"/shipments/{id}");

    private void GoToCreate() => NavigationManager.NavigateTo("/shipments/create");
}
